{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite",
            "outputDirectory": "dist"
        },
        "api": {
            "root": "api/",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/backend/:path*",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/auth/:path*",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/api/:path*",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
