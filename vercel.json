{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite",
            "outputDirectory": "dist"
        },
        "api": {
            "root": "api/",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/backend/:path*",
            "destination": {
                "service": "api",
                "path": "/:path*"
            }
        },
        {
            "source": "/:path*",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
