{
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite"
        },
        "api": {
            "root": "api/",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/:path*",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
