{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./src",
        "outDir": "./dist",

        "jsx": "react-jsx",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": false,
        "forceConsistentCasingInFileNames": true,

        "types": ["node"],
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["src/emails"]
}
